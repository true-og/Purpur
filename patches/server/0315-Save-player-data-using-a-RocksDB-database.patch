+package net.minecraft.world.level.storage;
+
+import com.mojang.logging.LogUtils;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.UUID;
+import javax.annotation.Nullable;
+import net.minecraft.nbt.CompoundTag;
+import org.rocksdb.ColumnFamilyHandle;
+import org.rocksdb.RocksDBException;
+import org.slf4j.Logger;
+
+// TrueOG start
+/**
+ * Plugin facing access to the RocksDB player data storage, reached through
+ * {@link PlayerDataStorage#api()}. Every method is world scoped: a null world addresses the default
+ * storage, the one vanilla reads and writes. Any other name, the server's own level name included,
+ * addresses that world's own storage, created on first save, so callers map the level name to null
+ * themselves. Data is the same tag vanilla writes to {@code <uuid>.dat}. A write to the default
+ * storage keeps the profile it replaces under the "previous" column family, the .dat_old of this
+ * storage; it is not reachable through this API.
+ *
+ * <p>Reads return null, false or an empty list when the storage is closed, the world is unknown
+ * or there is no data. {@link #get} and {@link #has} throw IllegalStateException when the storage
+ * fails or stored data can not be read, so a caller never mistakes a broken store for a new player.
+ * Writes, {@link #drop} included, return false when the storage is closed, player data saving is
+ * disabled in spigot.yml, or RocksDB fails. Nothing else throws except on a null argument.
+ *
+ * <p>Safe to call from any thread. Reads and writes run concurrently; {@link #drop} and server
+ * shutdown wait for calls in flight before freeing anything.
+ */
+public final class PlayerDataApi {
+
+    private static final Logger LOGGER = LogUtils.getLogger();
+    private final PlayerDataStorage storage;
+
+    PlayerDataApi(PlayerDataStorage storage) {
+        this.storage = storage;
+    }
+
+    /** The player's data on that world, upgraded to the current data version, or null when there is none. */
+    @Nullable
+    public CompoundTag get(@Nullable String world, UUID uuid) {
+        Objects.requireNonNull(uuid, "uuid");
+        return storage.withRead(() -> {
+            ColumnFamilyHandle handle = storage.resolveColumnFamily(world, false);
+            if (handle == null) return null;
+            try {
+                byte[] bytes = storage.readBytes(handle, uuid);
+                return bytes == null ? null : PlayerDataStorage.convert(PlayerDataStorage.fromBytes(bytes));
+            } catch (Exception e) {
+                LOGGER.error("Failed to load player data for {} on {}", uuid, describe(world), e);
+                throw new IllegalStateException("Player data storage failed for " + uuid + " on " + describe(world), e);
+            }
+        });
+    }
+
+    /**
+     * Stores one player's data on one or more worlds as a single atomic write: either every entry
+     * lands or none does. Keys are world names with null for the default storage, so the map
+     * must allow a null key (HashMap and Collections.singletonMap do, Map.of does not). A world's
+     * storage is created on first use. An empty map is a successful no-op.
+     */
+    public boolean saveAll(UUID uuid, Map<String, CompoundTag> perWorld) {
+        Objects.requireNonNull(uuid, "uuid");
+        Objects.requireNonNull(perWorld, "perWorld");
+        if (!storage.canWrite()) return false;
+        List<Pending> serialized = new ArrayList<>(perWorld.size());
+        for (Map.Entry<String, CompoundTag> entry : perWorld.entrySet()) {
+            String world = entry.getKey();
+            CompoundTag tag = Objects.requireNonNull(entry.getValue(), () -> "tag for " + describe(world));
+            try {
+                serialized.add(new Pending(world, PlayerDataStorage.toBytes(tag)));
+            } catch (IOException e) {
+                LOGGER.warn("Failed to serialize player data for {} on {}", uuid, describe(world), e);
+                return false;
+            }
+        }
+        if (serialized.isEmpty()) return true;
+        return storage.withRead(() -> {
+            if (!storage.canWrite()) return false;
+            List<PlayerDataStorage.Write> writes = new ArrayList<>(serialized.size());
+            for (Pending pending : serialized) {
+                ColumnFamilyHandle handle = storage.resolveColumnFamily(pending.world(), true);
+                if (handle == null) return false;
+                writes.add(new PlayerDataStorage.Write(handle, pending.bytes()));
+            }
+            try {
+                storage.writeAll(uuid, writes);
+                return true;
+            } catch (RocksDBException e) {
+                LOGGER.warn("Failed to save player data for {} on {} worlds", uuid, writes.size(), e);
+                return false;
+            }
+        });
+    }
+
+    /** True when the player has data on that world. */
+    public boolean has(@Nullable String world, UUID uuid) {
+        Objects.requireNonNull(uuid, "uuid");
+        return storage.withRead(() -> {
+            ColumnFamilyHandle handle = storage.resolveColumnFamily(world, false);
+            if (handle == null) return false;
+            try {
+                return storage.readBytes(handle, uuid) != null;
+            } catch (RocksDBException e) {
+                LOGGER.error("Failed to check player data for {} on {}", uuid, describe(world), e);
+                throw new IllegalStateException("Player data storage failed for " + uuid + " on " + describe(world), e);
+            }
+        });
+    }
+
+    /** Every player with data on that world. Empty for an unknown world. */
+    public List<UUID> seen(@Nullable String world) {
+        return storage.withRead(() -> {
+            ColumnFamilyHandle handle = storage.resolveColumnFamily(world, false);
+            if (handle == null) return new ArrayList<>();
+            return storage.listPlayers(handle);
+        });
+    }
+
+    /**
+     * Deletes a world's own storage. The default storage and the storages of the server's own level,
+     * its nether and its end can not be dropped. True when something was removed or there was nothing
+     * to remove; false for a protected world, a refused write
+     * or a RocksDB failure, the last of which is logged.
+     */
+    public boolean drop(String world) {
+        Objects.requireNonNull(world, "world");
+        return storage.dropWorld(world);
+    }
+
+    /**
+     * Copies every player's data from one storage into another world's storage, overwriting.
+     * Returns the number of players copied, 0 when the source is unknown or both name the same
+     * storage, or -1 on failure or when the target is the server's own level, its nether or its end,
+     * whose storages are never overwritten this way. On failure the target may hold part of the copy.
+     */
+    public int copy(@Nullable String from, String to) {
+        Objects.requireNonNull(to, "to");
+        if (to.equals(from)) return 0;
+        if (storage.isProtected(to)) {
+            LOGGER.warn("Refused to copy player data over main world {}", to);
+            return -1;
+        }
+        return storage.withRead(() -> {
+            if (!storage.canWrite()) return -1;
+            ColumnFamilyHandle source = storage.resolveColumnFamily(from, false);
+            if (source == null) return 0;
+            ColumnFamilyHandle target = storage.resolveColumnFamily(to, true);
+            if (target == null) return -1;
+            try {
+                return storage.copyAll(source, target);
+            } catch (RocksDBException e) {
+                LOGGER.warn("Failed to copy player data from {} to {}", describe(from), describe(to), e);
+                return -1;
+            }
+        });
+    }
+
+    /** Forces buffered writes to durable storage, so a crash after this returns cannot lose prior saves. True on success. */
+    public boolean flush() {
+        return storage.flushWal();
+    }
+
+    // A serialized tag waiting for its column family, resolved once the read lock is held.
+    private record Pending(@Nullable String world, byte[] bytes) {}
+
+    private String describe(@Nullable String world) {
+        return world == null ? "the default storage" : "world " + world;
+    }
+}
+// TrueOG end
