+    private ColumnFamilyHandle getOrCreateWorldColumnFamily(String world) {
+        if (closed) return null;
+        String worldName = "world:" + world;
+        return worldHandles.computeIfAbsent(worldName, key -> {
+            ColumnFamilyHandle handle = null;
+            try {
+                handle = rocksDB.createColumnFamily(
+                    new ColumnFamilyDescriptor(
+                        key.getBytes(StandardCharsets.UTF_8),
+                        columnFamilyOptions
+                    )
+                );
+            } catch (RocksDBException e) {
+                PlayerDataStorage.LOGGER.warn("Failed to create a new column for world " + world);
+            }
+            return handle;
+        });
+    }
