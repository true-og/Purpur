+        // TrueOG start
+        try {
+            // For faster lookups
+            BlockBasedTableConfig tableConfig = new BlockBasedTableConfig().setFilterPolicy(new BloomFilter(10));
+
+            dbOptions = new DBOptions()
+                    .setCreateIfMissing(true)
+                    .setMaxLogFileSize(10_485_760)
+                    .setKeepLogFileNum(5);
+
+            columnFamilyOptions = new ColumnFamilyOptions()
+                    .setCompressionType(CompressionType.LZ4_COMPRESSION)
+                    .setTableFormatConfig(tableConfig);
+
+            String path = session.getLevelPath(LevelResource.ROOT).resolve("playerdatadb").toAbsolutePath().toString();
+
+            List<ColumnFamilyDescriptor> descriptors = new ArrayList<>();
+            try (Options options = new Options().setCreateIfMissing(true)) {
+                for (byte[] name : RocksDB.listColumnFamilies(options, path)) {
+                    descriptors.add(new ColumnFamilyDescriptor(name, columnFamilyOptions));
+                }
+            }
+            if (descriptors.isEmpty()) {
+                descriptors.add(new ColumnFamilyDescriptor(RocksDB.DEFAULT_COLUMN_FAMILY, columnFamilyOptions));
+            }
+
+            List<ColumnFamilyHandle> handles = new ArrayList<>();
+            rocksDB = RocksDB.open(dbOptions, path, descriptors, handles);
+            for (int i = 0; i < descriptors.size(); i++) {
+                String name = new String(descriptors.get(i).getName(), StandardCharsets.UTF_8);
+                if (name.equals("default")) {
+                    defaultColumnFamily = handles.get(i);
+                    continue;
+                }
+                worldHandles.put(name, handles.get(i));
+            }
+        } catch (RocksDBException e) {
+            throw new RuntimeException(e);
+        }
+
+        migrate(session.getLevelPath(LevelResource.PLAYER_DATA_DIR));
+        // TrueOG end
